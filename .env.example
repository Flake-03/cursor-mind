GEMINI_API_KEY=
LIVE_MODEL=gemini-3.8-live
BROWSER_MODEL=gemini-3.8-flash
# Path to a native Chrome/Chromium binary. Leave empty to discover automatically.
CHROME_PATH=
MAX_AGENTS=2
MAX_STEPS=60
TASK_TIMEOUT=600
# Profiles, downloads and task results stay here; relative to the working directory.
DATA_DIR=.data
# Page shown if a browser must reopen without a new task URL.
HOME_URL=about:blank
